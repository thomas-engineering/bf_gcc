{
    "version": 4,
    "configurations": [
        {
            "name": "AVR Butterfly (ATmega169)",
            "compilerPath": "${env:HOME}/.arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/bin/avr-gcc",
            "cStandard": "gnu99",
            "intelliSenseMode": "gcc-x64",
            "includePath": [
                "${workspaceFolder}/main",
                "${workspaceFolder}/bf_boot",
                "${env:HOME}/.arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/avr/include"
            ],
            "defines": [
                "__AVR_ATmega169__",
                "F_CPU=1000000UL",
                "__flash="
            ],
            "compilerArgs": [
                "-mmcu=atmega169"
            ]
        }
    ]
}