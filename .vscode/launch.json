{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug on Butterfly (AVR Dragon JTAG)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/main/build/main.elf",
            "cwd": "${workspaceFolder}/main",
            "MIMode": "gdb",
            "miDebuggerPath": "avr-gdb",
            "miDebuggerServerAddress": "localhost:4242",
            "stopAtEntry": true,
            "preLaunchTask": "avarice (AVR Dragon, JTAG)",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}